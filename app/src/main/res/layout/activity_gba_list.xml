<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:text="GBA 影片"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_all_rom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="false"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="找不到想要的影片？"
            android:textColor="@color/accent"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/gba_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="没有找到 .gba 文件\n把 M3 电影卡 ROM 放到设备里再回来"
        android:textColor="@color/text_sub"
        android:textSize="13sp"
        android:visibility="gone" />


    <LinearLayout
        android:id="@+id/gba_pull_zone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#14161C"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ProgressBar
            android:id="@+id/gba_pull_progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/gba_pull_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="松手刷新"
            android:textColor="@color/text_sub"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gba_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingLeft="16dp"
        android:paddingRight="12dp"
        android:paddingBottom="16dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="true"
        android:scrollbarSize="4dp"
        android:scrollbarStyle="insideInset"
        android:scrollbarFadeDuration="400"
        android:scrollbarThumbVertical="@drawable/scroll_thumb" />
</LinearLayout>
